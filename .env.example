# --- LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Active mailbox connector: demo | imap ---
# demo reads from data/sample_emails/ and never sends real email -- safe
# for testing and for a public demo deployment.
ACTIVE_CONNECTOR=demo

# --- IMAP (only used if ACTIVE_CONNECTOR=imap) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- SMTP (only used if ACTIVE_CONNECTOR=imap, for sending replies) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Auto-send policy ---
AUTO_SEND_CONFIDENCE_THRESHOLD=0.85
